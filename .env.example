REDIS_URL=redis://localhost:6379/0
PROVIDER=fake            # fake (free, deterministic) or groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CACHE_TTL_SECONDS=3600
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_BUDGET_USD=1.0
PRICE_INPUT_PER_MTOK=1.0
PRICE_OUTPUT_PER_MTOK=5.0
FAIL_OPEN=false          # Redis down: false = refuse requests (503), true = serve without limits
TRUST_PROXY=false        # true only behind a proxy you control (uses X-Forwarded-For)
